<mujoco model="x5a">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="x5a">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      <joint damping="1" armature="0.01"/>
      <default class="position">
        <position kp="2000" kv="100" ctrlrange="-3.14 3.14" forcerange="-100 100"/>
      </default>
      <default class="position_gripper">
        <position kp="500" kv="25" ctrlrange="0 0.044" forcerange="-50 50"/>
      </default>
    </default>
  </default>

  <!--
    Collision volumes (group 3, shown as translucent boxes/capsules).

    Each link is approximated by one or two primitives sized from the STL
    cross-sections, not its bounding box: long arms (link2/link3) use a capsule
    and a flat-ended box along the beam axis, and the wrist (link4/link6) is
    split into shaft + housing boxes so a wide bracket or motor housing does not
    inflate the thin shaft.

    Adjacent links physically share the joint housing and are excluded from
    self-collision via <contact><exclude> below; the two gripper fingers
    (link7/link8) are excluded from each other as well.
  -->

  <asset>
    <material name="gray" rgba="0.75294 0.75294 0.75294 1"/>
    <material name="link1_blue" rgba="0.79216 0.81961 0.93333 1"/>
    <material name="link3_white" rgba="1 0.98431 0.96471 1"/>
    <material name="link4_blue" rgba="0.79216 0.81961 0.92941 1"/>
    <material name="link5_gray" rgba="0.69804 0.69804 0.69804 1"/>
    <material name="link6_light" rgba="0.89804 0.91765 0.92941 1"/>
    <material name="white" rgba="1 1 1 1"/>

    <mesh file="base_link.STL"/>
    <mesh file="link1.STL"/>
    <mesh file="link2.STL"/>
    <mesh file="link3.STL"/>
    <mesh file="link4.STL"/>
    <mesh file="link5.STL"/>
    <mesh file="link6.STL"/>
    <mesh file="link7.STL"/>
    <mesh file="link8.STL"/>
  </asset>

  <worldbody>
    <body name="base_link" childclass="x5a">
      <inertial mass="0.43995" pos="-3.0001e-05 3.0589e-05 0.027324"
        fullinertia="0.00017 0.00017 0.00016 0 0 0"/>
      <geom mesh="base_link" material="gray"/>
      <geom name="base_link_collision" type="box" group="3" contype="1" conaffinity="1"
        size="0.03 0.03 0.03125" pos="0 0 0.03125" rgba="0.3 0.4 0.5 0.4"/>

      <body name="link1" pos="0 0 0.0605">
        <inertial mass="0.066982" pos="0.0054231 -0.0080289 0.017086"
          fullinertia="0.00008 0.00003 0.00008 0 0.00001 0"/>
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom mesh="link1" material="link1_blue"/>
        <geom name="link1_collision" type="box" group="3" contype="1" conaffinity="1"
          size="0.027 0.037 0.027" pos="0.0078 0 0.0287" rgba="0.3 0.4 0.5 0.4"/>

        <body name="link2" pos="0.02 0 0.04">
          <inertial mass="1.0795" pos="-0.13237 0.0020852 0.00010549"
            fullinertia="0.00051 0.01599 0.01605 0.00001 -0.00004 0"/>
          <joint name="joint2" type="hinge" axis="0 1 0" range="0 3.14"/>
          <geom mesh="link2" material="gray"/>
          <geom name="link2_collision" type="capsule" group="3" contype="1" conaffinity="1"
            fromto="-0.292 0.003 0 0.028 0.003 0" size="0.028" rgba="0.3 0.4 0.5 0.4"/>

          <body name="link3" pos="-0.264 0 0" euler="3.1416 0 0">
            <inertial mass="0.54534" pos="0.18531 0.00068376 -0.051638"
              fullinertia="0.00036 0.00423 0.00420 -0.00003 -0.00039 0.00001"/>
            <joint name="joint3" type="hinge" axis="0 1 0" range="-0 3.14"/>
            <geom mesh="link3" material="link3_white"/>
            <geom name="link3_collision" type="box" group="3" contype="1" conaffinity="1"
              size="0.107 0.025 0.021" pos="0.167 0 -0.055" rgba="0.3 0.4 0.5 0.4"/>
            <geom name="link3_housing_collision" type="box" group="3" contype="1" conaffinity="1"
              size="0.04 0.036 0.045" pos="0.022 0 -0.029" rgba="0.3 0.4 0.5 0.4"/>

            <body name="link4" pos="0.245 0 -0.056">
              <inertial mass="0.11714" pos="0.040231 0.0044807 -0.035335"
                fullinertia="0.00019 0.00023 0.00014 -0.00002 -0.00009 0.00002"/>
              <joint name="joint4" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
              <geom mesh="link4" material="link4_blue"/>
              <geom name="link4_collision" type="box" group="3" contype="1" conaffinity="1"
                size="0.026 0.029 0.018" pos="0.009 0 0" rgba="0.3 0.4 0.5 0.4"/>
              <geom name="link4_housing_collision" type="box" group="3" contype="1" conaffinity="1"
                size="0.032 0.029 0.0205" pos="0.067 0 -0.0655" rgba="0.3 0.4 0.5 0.4"/>

              <body name="link5" pos="0.06775 0.0005 -0.0865">
                <inertial mass="0.63488" pos="0.003612 -1.5455e-05 0.055214"
                  fullinertia="0.00083 0.00082 0.00026 0 0.00007 0"/>
                <joint name="joint5" type="hinge" axis="0 0 1" range="-1.57 1.57"/>
                <geom mesh="link5" material="link5_gray"/>
                <geom name="link5_collision" type="box" group="3" contype="1" conaffinity="1"
                  size="0.031 0.030 0.055" pos="0.0005 0 0.0585" rgba="0.3 0.4 0.5 0.4"/>

                <body name="link6" pos="0.02895 0 0.0865" euler="-3.1416 0 0">
                  <inertial mass="0.44089" pos="0.041697 2.4368e-05 0.00014464"
                    fullinertia="0.00038 0.00028 0.00050 0 0 0"/>
                  <joint name="joint6" type="hinge" axis="1 0 0" range="-3.14 3.14"/>
                  <geom mesh="link6" material="link6_light"/>
                  <!-- site：夹爪的作用点相对位置 -->
                  <site name="attachment_site" pos="0.08657 0 0" size="0.005" rgba="1 0 0 1"/>
                  <geom name="link6_collision" type="box" group="3" contype="1" conaffinity="1"
                    size="0.034 0.029 0.029" pos="0.034 0 0" rgba="0.3 0.4 0.5 0.4"/>
                  <geom name="link6_bracket_collision" type="box" group="3" contype="1" conaffinity="1"
                    size="0.008 0.085 0.028" pos="0.076 0 0" rgba="0.3 0.4 0.5 0.4"/>

                  <body name="link7" pos="0.08657 0.024896 -0.0002436">
                    <inertial mass="0.064798" pos="-0.00035522 -0.007827 -0.0029883"
                      fullinertia="0.00002 0.00003 0.00003 0 0 0"/>
                    <joint name="joint7" type="slide" axis="0 1 0" range="0 0.044"/>
                    <geom mesh="link7" material="white"/>
                    <geom name="link7_collision" type="box" group="3" contype="1" conaffinity="1"
                      size="0.007 0.014 0.0305" pos="-0.007 -0.002 0.0005" rgba="0.3 0.4 0.5 0.4"
                      friction="2 0.5 0.01"/>
                  </body>

                  <body name="link8" pos="0.08657 -0.0249 -0.00024366">
                    <inertial mass="0.064798" pos="-0.00035522 0.0078277 0.0024201"
                      fullinertia="0.00002 0.00003 0.00003 0 0 0"/>
                    <joint name="joint8" type="slide" axis="0 -1 0" range="0 0.044"/>
                    <geom mesh="link8" material="white"/>
                    <geom name="link8_collision" type="box" group="3" contype="1" conaffinity="1"
                      size="0.007 0.014 0.0305" pos="-0.007 0.002 0.0005" rgba="0.3 0.4 0.5 0.4"
                      friction="2 0.5 0.01"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="link1"/>
    <exclude body1="base_link" body2="link2"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="link6" body2="link7"/>
    <exclude body1="link6" body2="link8"/>
    <exclude body1="link7" body2="link8"/>
  </contact>

  <actuator>
    <position class="position" name="joint1" joint="joint1"/>
    <position class="position" name="joint2" joint="joint2"/>
    <position class="position" name="joint3" joint="joint3"/>
    <position class="position" name="joint4" joint="joint4"/>
    <position class="position" name="joint5" joint="joint5"/>
    <position class="position" name="joint6" joint="joint6"/>
    <position class="position_gripper" name="joint7" joint="joint7"/>
    <position class="position_gripper" name="joint8" joint="joint8"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 0 0 0 0 0 0" ctrl="0 0 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
